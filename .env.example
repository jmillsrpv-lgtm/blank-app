# ============================================================
#  THE MAMMON VIDEO MACHINE - YOUR KEYS
#
#  1. Make a copy of this file and name the copy exactly:  .env
#  2. Paste each key after the = sign, with no spaces and no quotes.
#  3. Save the file, then stop the app and start it again.
#
#  Never share this file and never put it on the internet.
# ============================================================


# ---- SAFETY SWITCH -----------------------------------------
# true  = test mode. Runs the whole machine for free with fake
#         scenes, and still makes a real MP4 you can watch.
# false = the real thing. Spends real money.
# Leave this true until every key below is filled in.
MOCK_MODE=true


# ---- 1. THE SCRIPT WRITER (Anthropic / Claude) -------------
# Get it at: https://console.anthropic.com  ->  API Keys
ANTHROPIC_API_KEY=


# ---- 2. THE SCENE PICTURES (fal.ai) ------------------------
# This is the SAME key your PennyPixel app already uses.
# Get it at: https://fal.ai/dashboard/keys
FAL_KEY=


# ---- 3. THE ANIMATION (Google Veo, through Vertex AI) ------
# This one is fiddly. See the README section
# "Google Cloud, the fiddly one" for click-by-click steps.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# The full path to the service account .json file you downloaded,
# for example:  /Users/jake/keys/mammon-veo.json
GOOGLE_APPLICATION_CREDENTIALS=


# ---- 4. THE VOICES (ElevenLabs) ----------------------------
# Get it at: https://elevenlabs.io  ->  your picture  ->  API Keys
ELEVENLABS_API_KEY=
# changer = use the voices Veo made and swap them (what the plan asks for)
# tts     = read the script lines out loud instead. Cheaper.
VOICE_MODE=changer


# ---- 5. THE LIP SYNC (Sync Labs lipsync-2) -----------------
# fal  = runs Sync's lipsync-2 through fal.ai, using the FAL_KEY above.
#        Leave it on fal. It is the only one that works from your
#        own computer.
# sync = talk to Sync Labs directly. Only once this app is online.
LIPSYNC_PROVIDER=fal
SYNC_LABS_API_KEY=


# ---- 6. MONEY AND QUALITY ----------------------------------
# Runs by itself under this. Stops and asks over it.
COST_CAP_USD=8
# Claude looks at every clip to check the faces. false to switch off.
QUALITY_CHECK=true
# The cha-ching. Needs a sound file at assets/cha-ching.mp3
SFX_ENABLED=true
# Only needed if captions fail with "Cannot find a valid font".
# Put the full path to a .ttf file here, for example on a Mac:
# CAPTION_FONT_FILE=/System/Library/Fonts/Supplemental/Georgia.ttf
CAPTION_FONT_FILE=
